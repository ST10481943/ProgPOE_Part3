@using System.Data.SqlClient
@using API_template.backend

@{
    ViewData["Title"] = "Login";
    Layout = null;

    var userName = Context.Session.GetString("user_name") ?? "";
    var isLoggedIn = !string.IsNullOrEmpty(userName);

    string errorMsg = "";

    if (Context.Request.Method == "POST")
    {
        string email = Context.Request.Form["loginEmail"].ToString().Trim();
        string password = Context.Request.Form["loginPassword"].ToString().Trim();

        if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password))
        {
            errorMsg = "Email and password are both required.";
        }
        else if (!email.Contains("@") || !email.Contains("."))
        {
            errorMsg = "Please enter a valid email address.";
        }
        else
        {
            login_backend users_manager = new login_backend();
            string result = users_manager.login(email, password, Context);

            if (result.StartsWith("Login"))
            {
                Context.Response.Redirect("/Home/dashboard");
                return;
            }

            errorMsg = result;
        }
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
</head>
<body>

    <nav class="menu" aria-label="Main navigation">
        <div class="menu_inner">
            <a class="menu_brand" href="/">
                <img src="~/images/logo.png" alt="Logo" class="menu_logo">
            </a>

            <button class="menu_toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="menuList">
                <i class="fa fa-bars"></i>
            </button>

            <ul class="menu_list" id="menuList">
                <li class="menu_item">
                    <a class="menu_link" href="/"><i class="fa fa-home"></i><span>Home</span></a>
                </li>
                <li class="menu_item">
                    <a class="menu_link" href="/Home/about"><i class="fa fa-info-circle"></i><span>About</span></a>
                </li>
                <li class="menu_item">
                    <a class="menu_link" href="/Home/events"><i class="fa fa-flag"></i><span>Marathons</span></a>
                </li>
                <li class="menu_item">
                    <a class="menu_link" href="/Home/contact"><i class="fa fa-envelope"></i><span>Contact</span></a>
                </li>
                <li class="menu_item">
                    <a class="menu_link" href="/Home/login"><i class="fa fa-sign-in"></i><span>Login</span></a>
                </li>
                <li class="menu_item">
                    <a class="menu_link menu_link_accent" href="/Home/register"><i class="fa fa-user-plus"></i><span>Register</span></a>
                </li>
            </ul>
        </div>
    </nav>

    <main class="login">

        <section class="login_intro">
            <div class="login_intro_overlay"></div>
            <div class="login_intro_content">
                <h1 class="login_title">Welcome<br>back.</h1>
                <p class="login_subtitle">
                    Log in to join marathons as a participant or manage the ones you organize.
                </p>
            </div>
        </section>

        <section class="login_main">
            <div class="login_grid">

                <div class="login_form_wrap" style="border: 1px solid #e5e5e5; border-radius: 8px; padding: 2.5rem;">
                    <h2 class="login_section_title">Log in to your account</h2>
                    <p class="login_section_text">New here? <a class="login_inline_link" href="/Home/register">Create an account</a>.</p>

                    @if (!string.IsNullOrEmpty(errorMsg))
                    {
                        <div class="login_alert">
                            <i class="fa fa-exclamation-circle"></i>
                            <span>@errorMsg</span>
                        </div>
                    }

                    <form class="login_form" method="post" action="/Home/login">
                        <div class="login_field">
                            <label class="login_label" for="loginEmail">Email</label>
                            <input class="login_input" id="loginEmail" name="loginEmail" type="email" placeholder="your@gmail.com" required maxlength="150">
                        </div>

                        <div class="login_field">
                            <label class="login_label" for="loginPassword">Password</label>
                            <input class="login_input" id="loginPassword" name="loginPassword" type="password" placeholder="Your password" required minlength="6" maxlength="255">
                        </div>

                        <div class="login_row">
                            <label class="login_checkbox_wrap">
                                <input class="login_checkbox" name="loginRemember" type="checkbox" value="true">
                                <span class="login_checkbox_text">Remember me</span>
                            </label>
                            <a class="login_inline_link" href="#">Forgot password?</a>
                        </div>

                        <button class="login_btn" type="submit">
                            <i class="fa fa-sign-in"></i>
                            <span>Log in</span>
                        </button>
                    </form>
                </div>
                <aside class="login_side">
                    <div class="login_logo_card">
                        <img src="~/images/logo.png" alt="Logo" class="login_logo_image">
                    </div>
                </aside>

            </div>
        </section>

    </main>

    <footer class="footer">
        <div class="footer_inner">

            <div class="footer_middle">
                <div class="footer_col">
                    <h4 class="footer_col_title">Explore</h4>
                    <ul class="footer_list">
                        <li><a class="footer_link" href="/">Home</a></li>
                        <li><a class="footer_link" href="/Home/about">About</a></li>
                        <li><a class="footer_link" href="/Home/events">Marathons</a></li>
                        <li><a class="footer_link" href="/Home/contact">Contact</a></li>
                    </ul>
                </div>

                <div class="footer_col">
                    <h4 class="footer_col_title">Your account</h4>
                    <ul class="footer_list">
                        <li><a class="footer_link" href="/Home/login">Log in</a></li>
                        <li><a class="footer_link" href="/Home/register">Create account</a></li>
                        <li><a class="footer_link" href="/Home/dashboard">Dashboard</a></li>
                    </ul>
                </div>

                <div class="footer_col">
                    <h4 class="footer_col_title">Get in touch</h4>
                    <ul class="footer_list footer_list_contact">
                        <li><i class="fa fa-map-marker"></i> Johannesburg, South Africa</li>
                        <li><i class="fa fa-phone"></i> +27 11 234 5678</li>
                        <li><i class="fa fa-envelope"></i> hello@example.com</li>
                    </ul>
                </div>

                <div class="footer_col">
                    <h4 class="footer_col_title">Follow</h4>
                    <div class="footer_socials">
                        <a class="footer_social" href="#" aria-label="Facebook"><i class="fa fa-facebook"></i></a>
                        <a class="footer_social" href="#" aria-label="Twitter"><i class="fa fa-twitter"></i></a>
                        <a class="footer_social" href="#" aria-label="Instagram"><i class="fa fa-instagram"></i></a>
                        <a class="footer_social" href="#" aria-label="YouTube"><i class="fa fa-youtube-play"></i></a>
                    </div>
                </div>
            </div>

            <div class="footer_bottom">
                <p class="footer_copy">© 2026 Marathon. All rights reserved.</p>
                <ul class="footer_legal">
                    <li><a class="footer_link" href="#">Privacy</a></li>
                    <li><a class="footer_link" href="#">Terms</a></li>
                </ul>
            </div>

        </div>
    </footer>

    <script>
            (function () {
                const toggle = document.getElementById('menuToggle');
                const list = document.getElementById('menuList');
                if (!toggle || !list) return;

                toggle.addEventListener('click', function () {
                    const isOpen = list.classList.toggle('is_open');
                    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

                    const icon = toggle.querySelector('i');
                    if (icon) {
                        icon.className = isOpen ? 'fa fa-times' : 'fa fa-bars';
                    }
                });

                list.querySelectorAll('.menu_link').forEach(function (link) {
                    link.addEventListener('click', function () {
                        if (window.innerWidth <= 768) {
                            list.classList.remove('is_open');
                            toggle.setAttribute('aria-expanded', 'false');
                            const icon = toggle.querySelector('i');
                            if (icon) icon.className = 'fa fa-bars';
                        }
                    });
                });

                window.addEventListener('resize', function () {
                    if (window.innerWidth > 768) {
                        list.classList.remove('is_open');
                        toggle.setAttribute('aria-expanded', 'false');
                        const icon = toggle.querySelector('i');
                        if (icon) icon.className = 'fa fa-bars';
                    }
                });
            })();
    </script>

</body>
</html>