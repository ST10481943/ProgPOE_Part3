                    font-size: 1.05rem;
                    flex-shrink: 0;
                    margin-top: 2px;
                }

            .myevents_alert_success {
                background: #eefaf1;
                border: 1px solid #b6e3c3;
                color: #1b7a3e;
            }

            .myevents_alert_error {
