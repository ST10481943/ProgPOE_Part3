                font-weight: 700;
                color: #1e5aaa;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin: 0 0 0.35rem;
            }

            .myevents_title {
                font-size: 1.75rem;
                font-weight: 700;
                color: #0d1b33;
                letter-spacing: -0.5px;
                margin: 0 0 0.35rem;
            }

            .myevents_subtitle {
