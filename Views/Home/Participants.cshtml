@using System.Data.SqlClient
@using API_template.backend

@{
    Layout = null;
    var userName = Context.Session.GetString("user_name") ?? "User";
    var userId = Context.Session.GetString("user_id") ?? "0";
    int organizer_id = Int32.Parse(userId);

    manage_events events_manager = new manage_events();
    manage_categories categories_manager = new manage_categories();
    manage_results results_manager = new manage_results();

    string successMsg = TempData["ResultSuccess"] as string;
    string errorMsg = TempData["ResultError"] as string;

    if (Context.Request.Method == "POST")
    {
        string action = Context.Request.Form["formAction"].ToString().Trim();

        if (action == "record")
        {
            string enrolmentIdRaw = Context.Request.Form["enrolmentId"].ToString().Trim();
            string finishTimeRaw = Context.Request.Form["finishTime"].ToString().Trim();
            string finishPositionRaw = Context.Request.Form["finishPosition"].ToString().Trim();

            int enrolmentId;
            TimeSpan finishTime;
            int finishPosition;

            if (!int.TryParse(enrolmentIdRaw, out enrolmentId) || enrolmentId <= 0)
            {
                errorMsg = "Invalid enrolment selected.";
            }
            else if (!TimeSpan.TryParse(finishTimeRaw, out finishTime))
            {
                errorMsg = "Please enter a valid finish time.";
            }
            else if (!int.TryParse(finishPositionRaw, out finishPosition) || finishPosition <= 0)
            {
                errorMsg = "Please enter a valid finish position.";
            }
            else
            {
                string result = results_manager.store_result(
                    enrolmentId,
                    finishTime,
                    finishPosition,
                    organizer_id.ToString(),
                    Context);

                if (result.Contains("successfully"))
                {
                    TempData["ResultSuccess"] = result;
                }
                else
                {
                    TempData["ResultError"] = result;
                }

                Context.Response.Redirect(Context.Request.Path);
                return;
            }
        }
        else if (action == "update")
        {
            string resultIdRaw = Context.Request.Form["resultId"].ToString().Trim();
            string finishTimeRaw = Context.Request.Form["finishTime"].ToString().Trim();
            string finishPositionRaw = Context.Request.Form["finishPosition"].ToString().Trim();

            int resultId;
            TimeSpan finishTime;
            int finishPosition;

            if (!int.TryParse(resultIdRaw, out resultId) || resultId <= 0)
            {
                errorMsg = "Invalid result selected.";
            }
            else if (!TimeSpan.TryParse(finishTimeRaw, out finishTime))
            {
                errorMsg = "Please enter a valid finish time.";
            }
            else if (!int.TryParse(finishPositionRaw, out finishPosition) || finishPosition <= 0)
            {
                errorMsg = "Please enter a valid finish position.";
            }
            else
            {
                string result = results_manager.updating_results(
                    resultId,
                    finishTime,
                    finishPosition,
                    organizer_id.ToString(),
                    Context);

                if (result.Contains("successfully"))
                {
                    TempData["ResultSuccess"] = result;
                }
                else
                {
                    TempData["ResultError"] = result;
                }

                Context.Response.Redirect(Context.Request.Path);
                return;
            }
        }
        else if (action == "delete")
        {
            string resultIdRaw = Context.Request.Form["resultId"].ToString().Trim();

            int resultId;

            if (!int.TryParse(resultIdRaw, out resultId) || resultId <= 0)
            {
                errorMsg = "Invalid result selected.";
            }
            else
            {
                string result = results_manager.deleting_results(
                    resultId,
                    organizer_id.ToString(),
                    Context);

                if (result.Contains("successfully"))
                {
                    TempData["ResultSuccess"] = result;
                }
                else
                {
                    TempData["ResultError"] = result;
                }

                Context.Response.Redirect(Context.Request.Path);
                return;
            }
        }
    }

    var myEvents = new List<Dictionary<string, object>>();
    var myCategories = new List<Dictionary<string, object>>();
    var allEnrolments = new List<Dictionary<string, object>>();

    SqlDataReader read_events = events_manager.view_eventsSite(organizer_id);
    try
    {
        while (read_events.Read())
        {
            myEvents.Add(new Dictionary<string, object>
            {
                { "eventID", read_events["eventID"] },
                { "eventName", read_events["eventName"] },
                { "date", read_events["date"] },
                { "location", read_events["location"] },
                { "eventType", read_events["eventType"] },
                { "category_id", read_events["category_id"] },
                { "image", read_events["image"] }
            });
        }
    }
    finally { read_events.Close(); }

    SqlDataReader read_categories = categories_manager.view_categoriesSite(organizer_id);
    try
    {
        while (read_categories.Read())
        {
            myCategories.Add(new Dictionary<string, object>
            {
                { "id", read_categories["id"] },
                { "name", read_categories["name"] }
            });
        }
    }
    finally { read_categories.Close(); }

    foreach (var ev in myEvents)
    {
        int evId = Convert.ToInt32(ev["eventID"]);
        SqlDataReader read_enrolments = results_manager.view_enrolments_by_eventSite(evId, organizer_id);

        try
        {
            while (read_enrolments.Read())
            {
                bool hasResult = read_enrolments["resultID"] != DBNull.Value;

                allEnrolments.Add(new Dictionary<string, object>
                {
                    { "eventID", evId },
                    { "enrolmentID", read_enrolments["enrolmentID"] },
                    { "enrolmentDate", read_enrolments["enrolmentDate"] },
                    { "fullname", read_enrolments["fullname"] },
                    { "email", read_enrolments["email"] },
                    { "resultID", hasResult ? read_enrolments["resultID"] : DBNull.Value },
                    { "finishTime", hasResult ? read_enrolments["finishTime"] : DBNull.Value },
                    { "finishPosition", hasResult ? read_enrolments["finishPosition"] : DBNull.Value }
                });
            }
        }
        finally { read_enrolments.Close(); }
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <style>
