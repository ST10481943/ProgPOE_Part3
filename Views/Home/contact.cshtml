@using System.Data.SqlClient
@using API_template.backend

@{
    ViewData["Title"] = "Contact";
    Layout = null;

    var userName = Context.Session.GetString("user_name") ?? "";
    var isLoggedIn = !string.IsNullOrEmpty(userName);

    string successMsg = "";
    string errorMsg = "";

    if (Context.Request.Method == "POST")
    {
        string name = Context.Request.Form["contactName"].ToString().Trim();
        string email = Context.Request.Form["contactEmail"].ToString().Trim();
        string subject = Context.Request.Form["contactSubject"].ToString().Trim();
        string message = Context.Request.Form["contactMessage"].ToString().Trim();

        if (string.IsNullOrEmpty(name) || string.IsNullOrEmpty(email) || string.IsNullOrEmpty(subject) || string.IsNullOrEmpty(message))
        {
            errorMsg = "All fields are required. Please fill in every field.";
        }
        else if (!email.Contains("@") || !email.Contains("."))
        {
            errorMsg = "Please enter a valid email address.";
        }
        else
        {
            successMsg = "Got it, " + name + ". We'll be in touch shortly.";
        }
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
</head>
<body>

    <nav class="menu" aria-label="Main navigation">
        <div class="menu_inner">
            <a class="menu_brand" href="/">
                <img src="~/images/logo.png" alt="Logo" class="menu_logo">
            </a>

            <button class="menu_toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="menuList">
                <i class="fa fa-bars"></i>
            </button>

            <ul class="menu_list" id="menuList">
                <li class="menu_item">
                    <a class="menu_link" href="/"><i class="fa fa-home"></i><span>Home</span></a>
                </li>
                <li class="menu_item">
                    <a class="menu_link" href="/Home/about"><i class="fa fa-info-circle"></i><span>About</span></a>
                </li>
                <li class="menu_item">
                    <a class="menu_link" href="/Home/events"><i class="fa fa-flag"></i><span>Marathons</span></a>
                </li>
                <li class="menu_item">
                    <a class="menu_link" href="/Home/contact"><i class="fa fa-envelope"></i><span>Contact</span></a>
                </li>
                <li class="menu_item">
                    <a class="menu_link" href="/Home/login"><i class="fa fa-sign-in"></i><span>Login</span></a>
                </li>
                <li class="menu_item">
                    <a class="menu_link menu_link_accent" href="/Home/register"><i class="fa fa-user-plus"></i><span>Register</span></a>
                </li>
            </ul>
        </div>
    </nav>

    <main class="contact">

        <section class="contact_intro">
            <div class="contact_intro_overlay"></div>
            <div class="contact_intro_content">
                <h1 class="contact_title">Talk to a human,<br>not a chatbot.</h1>
                <p class="contact_subtitle">
                    Something broke. Something confused you. Something's missing.
                    Whatever it is, write to us and a real person will read it.
                </p>
            </div>
        </section>

        <section class="contact_main">
            <div class="contact_grid">

                <div class="contact_form_wrap" style="border: 1px solid #e5e5e5; border-radius: 8px; padding: 2.5rem;">
                    <h2 class="contact_section_title">Write to us</h2>
                    <p class="contact_section_text">Give us a bit of context and we'll reply within one business day.</p>

                    @if (!string.IsNullOrEmpty(successMsg))
                    {
                        <div class="contact_alert contact_alert_success">
                            <i class="fa fa-check-circle"></i>
                            <span>@successMsg</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMsg))
                    {
                        <div class="contact_alert contact_alert_error">
                            <i class="fa fa-exclamation-circle"></i>
                            <span>@errorMsg</span>
                        </div>
                    }

                    <form class="contact_form" method="post" action="/Home/contact">
                        <div class="contact_field">
                            <label class="contact_label" for="contactName">What should we call you?</label>
                            <input class="contact_input" id="contactName" name="contactName" type="text" placeholder="First and last name" required maxlength="100">
                        </div>

                        <div class="contact_field">
                            <label class="contact_label" for="contactEmail">Where do we reply?</label>
                            <input class="contact_input" id="contactEmail" name="contactEmail" type="email" placeholder="you@somewhere.com" required maxlength="150">
                        </div>

                        <div class="contact_field">
                            <label class="contact_label" for="contactSubject">One-line summary</label>
                            <input class="contact_input" id="contactSubject" name="contactSubject" type="text" placeholder="e.g. can't join a marathon" required maxlength="150">
                        </div>

                        <div class="contact_field">
                            <label class="contact_label" for="contactMessage">The full story</label>
                            <textarea class="contact_input contact_textarea" id="contactMessage" name="contactMessage" rows="6" placeholder="What happened, what you expected, what you need." required maxlength="2000"></textarea>
                        </div>

                        <button class="contact_btn" type="submit">
                            <i class="fa fa-paper-plane"></i>
                            <span>Send it</span>
                        </button>
                    </form>
                </div>

                <aside class="contact_info">
                    <h2 class="contact_section_title">Or skip the form</h2>
                    <p class="contact_section_text">Direct lines work better for some things. Here they are.</p>

                    <ul class="contact_info_list">
                        <li class="contact_info_item">
                            <div class="contact_info_icon"><i class="fa fa-map-marker"></i></div>
                            <div>
                                <h3 class="contact_info_title">Where we are</h3>
                                <p class="contact_info_text">Braamfontein, Johannesburg</p>
                            </div>
                        </li>

                        <li class="contact_info_item">
                            <div class="contact_info_icon"><i class="fa fa-phone"></i></div>
                            <div>
                                <h3 class="contact_info_title">Call during the day</h3>
                                <p class="contact_info_text">+27 11 555 0199</p>
                            </div>
                        </li>

                        <li class="contact_info_item">
                            <div class="contact_info_icon"><i class="fa fa-envelope"></i></div>
                            <div>
                                <h3 class="contact_info_title">Email works too</h3>
                                <p class="contact_info_text">team@runlocal.co.za</p>
                            </div>
                        </li>

                        <li class="contact_info_item">
                            <div class="contact_info_icon"><i class="fa fa-clock-o"></i></div>
                            <div>
                                <h3 class="contact_info_title">When we're around</h3>
                                <p class="contact_info_text">Mon to Thu, 09:00 to 16:00. Fri, 09:00 to 13:00.</p>
                            </div>
                        </li>
                    </ul>

                    <div class="contact_socials">
                        <a class="contact_social" href="#" aria-label="Facebook"><i class="fa fa-facebook"></i></a>
                        <a class="contact_social" href="#" aria-label="Twitter"><i class="fa fa-twitter"></i></a>
                        <a class="contact_social" href="#" aria-label="Instagram"><i class="fa fa-instagram"></i></a>
                        <a class="contact_social" href="#" aria-label="YouTube"><i class="fa fa-youtube-play"></i></a>
                    </div>
                </aside>

            </div>
        </section>

    </main>

    <footer class="footer">
        <div class="footer_inner">

            <div class="footer_middle">
                <div class="footer_col">
                    <h4 class="footer_col_title">Explore</h4>
                    <ul class="footer_list">
                        <li><a class="footer_link" href="/">Home</a></li>
                        <li><a class="footer_link" href="/Home/about">About</a></li>
                        <li><a class="footer_link" href="/Home/events">Marathons</a></li>
                        <li><a class="footer_link" href="/Home/contact">Contact</a></li>
                    </ul>
                </div>

                <div class="footer_col">
                    <h4 class="footer_col_title">Your account</h4>
                    <ul class="footer_list">
                        <li><a class="footer_link" href="/Home/login">Log in</a></li>
                        <li><a class="footer_link" href="/Home/register">Create account</a></li>
                        <li><a class="footer_link" href="/Home/dashboard">Dashboard</a></li>
                    </ul>
                </div>

                <div class="footer_col">
                    <h4 class="footer_col_title">Get in touch</h4>
                    <ul class="footer_list footer_list_contact">
                        <li><i class="fa fa-map-marker"></i> Johannesburg, South Africa</li>
                        <li><i class="fa fa-phone"></i> +27 11 234 5678</li>
                        <li><i class="fa fa-envelope"></i> hello@example.com</li>
                    </ul>
                </div>

                <div class="footer_col">
                    <h4 class="footer_col_title">Follow</h4>
                    <div class="footer_socials">
                        <a class="footer_social" href="#" aria-label="Facebook"><i class="fa fa-facebook"></i></a>
                        <a class="footer_social" href="#" aria-label="Twitter"><i class="fa fa-twitter"></i></a>
                        <a class="footer_social" href="#" aria-label="Instagram"><i class="fa fa-instagram"></i></a>
                        <a class="footer_social" href="#" aria-label="YouTube"><i class="fa fa-youtube-play"></i></a>
                    </div>
                </div>
            </div>

            <div class="footer_bottom">
                <p class="footer_copy">© 2026 Marathon. All rights reserved.</p>
                <ul class="footer_legal">
                    <li><a class="footer_link" href="#">Privacy</a></li>
                    <li><a class="footer_link" href="#">Terms</a></li>
                </ul>
            </div>

        </div>
    </footer>

    <script>
            (function () {
                const toggle = document.getElementById('menuToggle');
                const list = document.getElementById('menuList');
                if (!toggle || !list) return;

                toggle.addEventListener('click', function () {
                    const isOpen = list.classList.toggle('is_open');
                    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

                    const icon = toggle.querySelector('i');
                    if (icon) {
                        icon.className = isOpen ? 'fa fa-times' : 'fa fa-bars';
                    }
                });

                list.querySelectorAll('.menu_link').forEach(function (link) {
                    link.addEventListener('click', function () {
                        if (window.innerWidth <= 768) {
                            list.classList.remove('is_open');
                            toggle.setAttribute('aria-expanded', 'false');
                            const icon = toggle.querySelector('i');
                            if (icon) icon.className = 'fa fa-bars';
                        }
                    });
                });

                window.addEventListener('resize', function () {
                    if (window.innerWidth > 768) {
                        list.classList.remove('is_open');
                        toggle.setAttribute('aria-expanded', 'false');
                        const icon = toggle.querySelector('i');
                        if (icon) icon.className = 'fa fa-bars';
                    }
                });
            })();
    </script>

</body>
</html>