                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html, body {
                width: 100%;
                background: #ffffff;
            }

            body {
                font-family: 'Inter', 'Poppins', system-ui, sans-serif;
                background: #ffffff;
                color: #333;
            }

            .myevents {
                padding: 2rem 2.5rem;
